# Application Settings
APP_NAME="Nagpur Pulse Backend API"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# CORS Settings
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,*"

# Database Settings (Neon PostgreSQL or SQLite)
DATABASE_URL="sqlite:///./nagpur_pulse.db"

# ML Service Settings
ML_SERVICE_URL="http://localhost:8001"
ML_SERVICE_TIMEOUT=10
RISK_REFRESH_INTERVAL=30
RISK_STALE_AFTER_MINUTES=10
ENABLE_MOCK_FALLBACK=True

# TomTom Routing & Traffic API Settings (Server-side ONLY)
TOMTOM_API_KEY="your_tomtom_api_key_here"
TOMTOM_BASE_URL="https://api.tomtom.com"
TOMTOM_TRAFFIC_ENABLED=false

# Weather API Settings
OPENWEATHER_API_KEY="your_openweather_api_key_here"
OPENWEATHER_BASE_URL="https://api.openweathermap.org/data/2.5"
WEATHER_CACHE_TTL_MINUTES=15

# ==============================================================================
# INTEGRATION-READY ADAPTER LAYER PROVIDER CONFIGURATION
# ==============================================================================
# Traffic Provider: "tomtom", "government", or "simulated"
TRAFFIC_PROVIDER="simulated"
TRAFFIC_FALLBACK_PROVIDER="cached"
TRAFFIC_PROVIDER_TIMEOUT=5
TRAFFIC_MAX_AGE_SECONDS=300

# Weather Provider: "openweather", "government", or "simulated"
WEATHER_PROVIDER="openweather"
WEATHER_PROVIDER_TIMEOUT=5
WEATHER_MAX_AGE_SECONDS=900

# Police Unit Provider: "simulated" or "government"
POLICE_PROVIDER="simulated"
POLICE_MAX_AGE_SECONDS=60

# Routing Provider: "tomtom" or "simulated"
ROUTING_PROVIDER="tomtom"
ROUTING_PROVIDER_TIMEOUT=5
MAX_PROVIDER_RETRIES=2
